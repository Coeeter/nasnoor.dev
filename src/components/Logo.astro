---
interface Props {
  size?: number
  class?: string
}

const { size = 40, class: className = "" } = Astro.props

const gridId = `logo-grid-${Math.random().toString(36).slice(2, 8)}`
const clipId = `logo-clip-${Math.random().toString(36).slice(2, 8)}`

const stroke =
  "M 2 15 C 7 9, 12 5, 17 6 C 20 7, 20 10, 19 15 C 18 25, 16 40, 15 50 " +
  "C 14 56, 18 57, 22 51 C 30 39, 38 24, 46 11 C 48 8, 52 7, 53 11 " +
  "C 54 16, 52 25, 51 33 C 50 41, 49 48, 49 52 C 49 56, 54 59, 62 61"
---

<svg
  class={className}
  data-logo
  width={size}
  height={size}
  viewBox="0 0 256 256"
  role="img"
  aria-label="N monogram"
>
  <defs>
    <pattern id={gridId} width="18" height="18" patternUnits="userSpaceOnUse">
      <path
        d="M 18 0 L 0 0 0 18"
        fill="none"
        stroke="var(--logo-grid)"
        stroke-width="1"></path>
    </pattern>
    <clipPath id={clipId}>
      <rect x="8" y="8" width="240" height="240" rx="52" ry="52"></rect>
    </clipPath>
  </defs>

  <rect
    x="8"
    y="8"
    width="240"
    height="240"
    rx="52"
    ry="52"
    fill="var(--logo-plate)"></rect>

  <g clip-path={`url(#${clipId})`}>
    <rect x="8" y="8" width="240" height="240" fill={`url(#${gridId})`}></rect>
  </g>

  <g transform="translate(30 28) scale(3.15)">
    <path
      class="ink"
      pathLength="100"
      d={stroke}
      transform="translate(0,64) scale(1,-1)"
      fill="none"
      stroke="var(--logo-ink)"
      stroke-width="4.25"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </g>
</svg>

<style>
  @keyframes logo-draw-in {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .ink {
    stroke-dasharray: 100 100;
    stroke-dashoffset: 0;
    animation: logo-draw-in 1.5s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .ink {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const FULL_PASS = 2400
  const SPAN = 200

  const setup = (svg: SVGSVGElement) => {
    const path = svg.querySelector<SVGPathElement>(".ink")
    if (!path) return

    let loop: Animation | null = null
    let leg: Animation | null = null
    let hovering = false
    let run = 0

    const offsetNow = () =>
      Number.parseFloat(getComputedStyle(path).strokeDashoffset) || 0

    const move = (from: number, to: number) =>
      path.animate([{ strokeDashoffset: from }, { strokeDashoffset: to }], {
        duration: (Math.abs(to - from) / SPAN) * FULL_PASS,
        easing: "linear",
        fill: "forwards",
      })

    const stopAll = () => {
      loop?.cancel()
      leg?.cancel()
      loop = null
      leg = null
    }

    const settled = async (animation: Animation) => {
      try {
        await animation.finished
        return true
      } catch {
        return false
      }
    }

    svg.addEventListener("mouseenter", async () => {
      hovering = true
      const token = ++run
      const at = offsetNow()
      stopAll()

      leg = move(at, -SPAN / 2)
      if (!(await settled(leg))) return
      if (token !== run || !hovering) return

      loop = path.animate(
        [{ strokeDashoffset: SPAN / 2 }, { strokeDashoffset: -SPAN / 2 }],
        { duration: FULL_PASS, iterations: Infinity, easing: "linear" },
      )
    })

    svg.addEventListener("mouseleave", async () => {
      hovering = false
      const token = ++run
      const at = offsetNow()
      stopAll()

      if (at > 0) {
        leg = move(at, 0)
        return
      }

      leg = move(at, -SPAN / 2)
      if (!(await settled(leg))) return
      if (token !== run || hovering) return
      leg = move(SPAN / 2, 0)
    })
  }

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document
      .querySelectorAll<SVGSVGElement>("svg[data-logo]")
      .forEach((svg) => setup(svg))
  }
</script>
