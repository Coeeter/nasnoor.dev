---
interface Props {
  id?: string
  title: string
}

const { id, title } = Astro.props
---

<section
  id={id}
  class="border-line mt-10 grid gap-x-10 gap-y-5 border-t pt-8 sm:grid-cols-[9rem_1fr]"
>
  <h2 class="text-muted text-xs font-semibold tracking-[0.14em] uppercase">
    {title}
  </h2>
  <div class="max-w-[68ch] min-w-0">
    <slot />
  </div>
</section>
